{
  "name": "dice-night-gamehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "wrangler dev --port 8787",
    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json",
    "build": "npm run check && vite build",
    "test": "node --import tsx --test tests/rules.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "preview": "wrangler dev --port 8787",
    "deploy": "npm run build && wrangler deploy",
    "cf:login": "wrangler login",
    "cf:whoami": "wrangler whoami",
    "test:capacity": "node scripts/capacity.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261106.1",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
