{
  "name": "dice-night-gamehub",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:server": "node --import tsx --watch services/rooms/server.ts",
    "dev:api": "node --env-file=.env --import tsx --watch services/api/server.ts",
    "start:api": "node --env-file=.env --import tsx services/api/server.ts",
    "setup:local": "node scripts/platform-setup.mjs",
    "platform:doctor": "node --env-file=.env --import tsx scripts/platform-doctor.ts",
    "platform:start": "node scripts/platform-start.mjs",
    "platform:browser": "node --import tsx scripts/platform-browser.mjs",
    "platform:capacity": "node --import tsx scripts/platform-capacity.mjs",
    "db:runtime-role": "node --env-file=.env --import tsx scripts/platform-runtime-role.ts",
    "artifact:gc": "node --env-file=.env --import tsx scripts/platform-gc.ts",
    "sample:zip": "node --env-file=.env --import tsx scripts/platform-sample.ts",
    "db:backup": "node --env-file=.env --import tsx scripts/platform-backup.ts backup",
    "db:restore-drill": "node --env-file=.env --import tsx scripts/platform-backup.ts drill",
    "objects:backup": "node --env-file=.env --import tsx scripts/platform-object-backup.ts backup",
    "objects:restore-drill": "node --env-file=.env --import tsx scripts/platform-object-backup.ts drill",
    "backup:business-drill": "node --env-file=.env --import tsx scripts/platform-backup-business-drill.ts",
    "test-access:reset": "node --env-file=.env --import tsx scripts/platform-reset.ts",
    "start:assets": "node --env-file=.env --import tsx services/assets/server.ts",
    "worker:once": "node --env-file=.env --import tsx scripts/platform-worker.ts --once",
    "worker:dev": "node --env-file=.env --import tsx scripts/platform-worker.ts",
    "artifacts:once": "node --env-file=.env --import tsx scripts/platform-artifact-worker.ts --once",
    "artifacts:dev": "node --env-file=.env --import tsx scripts/platform-artifact-worker.ts",
    "catalog:seed": "node --env-file=.env --import tsx scripts/platform-catalog.ts",
    "identity:admin": "node --env-file=.env --import tsx scripts/platform-identity.ts",
    "db:up": "node scripts/platform-compose.mjs up",
    "db:down": "node scripts/platform-compose.mjs down",
    "db:migrate": "node --env-file=.env --import tsx scripts/platform-db.ts migrate",
    "db:init": "node --env-file=.env --import tsx scripts/platform-db.ts init",
    "access:invite": "node --env-file=.env --import tsx scripts/platform-db.ts invite",
    "access:revoke": "node --env-file=.env --import tsx scripts/platform-db.ts revoke",
    "contracts:generate": "node --import tsx scripts/platform-contracts.ts",
    "contracts:check": "node --import tsx scripts/platform-contracts.ts --check",
    "test:api": "node --import tsx --test tests/api/*.test.ts",
    "check": "tsc -p tsconfig.web.json && tsc -p tsconfig.server.json && tsc -p tsconfig.platform.json",
    "build": "npm run check && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:integration": "node scripts/integration.mjs",
    "test:party-integration": "node scripts/party-integration.mjs",
    "preview": "node --import tsx services/rooms/server.ts",
    "start": "node --import tsx services/rooms/server.ts",
    "test:capacity": "node scripts/capacity.mjs",
    "test:rules-integration": "node scripts/rules-integration.mjs",
    "test:defuse-integration": "node scripts/defuse-integration.mjs",
    "test:p2p": "node scripts/p2p-browser.mjs",
    "test:p2p-protocol": "node --import tsx scripts/p2p-protocol.mjs"
  },
  "devDependencies": {
    "@fastify/type-provider-json-schema-to-ts": "5.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/ws": "^8.18.2",
    "json-schema-to-ts": "3.1.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.6"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/static": "10.1.10",
    "@fastify/swagger": "9.9.3",
    "fastify": "5.12.8",
    "fflate": "0.8.3",
    "pg": "8.23.1",
    "tldts": "7.4.19",
    "ws": "^8.22.2"
  }
}
